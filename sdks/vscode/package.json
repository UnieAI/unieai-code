{
  "name": "unieai-code",
  "displayName": "UnieAI Code",
  "description": "UnieAI Code for VS Code — chat with the UnieAI coding agent in your editor",
  "version": "0.9.1",
  "publisher": "unieai",
  "repository": {
    "type": "git",
    "url": "https://github.com/UnieAI/unieai-code"
  },
  "license": "Apache-2.0",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "unieai-code",
          "title": "UnieAI Code",
          "icon": "images/button-light.svg"
        }
      ]
    },
    "views": {
      "unieai-code": [
        {
          "type": "webview",
          "id": "unieai-code.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "unieai-code.focusChat",
        "title": "UnieAI Code: Open Chat"
      },
      {
        "command": "unieai-code.newChat",
        "title": "UnieAI Code: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "unieai-code.addFilepathToChat",
        "title": "UnieAI Code: Insert At-Mentioned"
      },
      {
        "command": "unieai-code.openTerminal",
        "title": "UnieAI Code: Open in Terminal (TUI)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "unieai-code.newChat",
          "when": "view == unieai-code.chatView",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "unieai-code.focusChat",
        "key": "cmd+alt+u",
        "mac": "cmd+alt+u",
        "win": "ctrl+alt+u",
        "linux": "ctrl+alt+u"
      },
      {
        "command": "unieai-code.addFilepathToChat",
        "key": "cmd+alt+m",
        "mac": "cmd+alt+m",
        "win": "ctrl+alt+M",
        "linux": "ctrl+alt+M"
      }
    ],
    "configuration": {
      "title": "UnieAI Code",
      "properties": {
        "unieai-code.executablePath": {
          "type": "string",
          "default": "unieai",
          "description": "Path to the unieai CLI executable."
        },
        "unieai-code.sandboxMode": {
          "type": "string",
          "enum": [
            "read-only",
            "workspace-write",
            "danger-full-access"
          ],
          "default": "workspace-write",
          "description": "Sandbox mode for agent turns started from the chat panel."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "compile": "bun run check-types && bun run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "bun run check-types && bun run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/vscode": "^1.94.0",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "esbuild": "^0.25.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "marked": "^12"
  }
}